# Caddy: HTTPS otomatis (Let's Encrypt), file statis, dan FastCGI ke PHP-FPM.
# Domain diambil dari variabel APP_DOMAIN di .env (lihat docker-compose.yml).

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	root * /var/www/html/public
	encode zstd gzip

	# File upload (logo, tanda tangan, gambar QRIS) dari volume storage.
	handle_path /storage/* {
		root * /var/www/html/storage/app/public
		file_server
	}

	# Asset hasil Vite punya hash di nama file → cache lama.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	php_fastcgi app:9000 {
		root /var/www/html/public
	}

	file_server

	log {
		output stdout
		format console
		level WARN
	}
}

# www → domain utama
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
