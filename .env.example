APP_NAME=eTagih
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QRISLY (Komerce) — pembayaran QRIS. Lihat docs/integrasi.md.
# QRIS toko di-upload dari Pengaturan → QRIS; status "lunas" dari webhook selalu
# diverifikasi ulang ke API QRISLY. QRISLY_MERCHANT_ID hanya cadangan.
# false = sandbox.
QRISLY_IS_PRODUCTION=false
QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
QRISLY_PRODUCTION_BASE_URL=https://api.collaborator.komerce.id/user
QRISLY_API_KEY=
QRISLY_MERCHANT_ID=

# WhatsApp (Fonnte) — notifikasi invoice, konfirmasi bayar, pengingat.
# Nomor pengirim mengikuti device yang terhubung ke token Fonnte.
FONNTE_BASE_URL=https://api.fonnte.com
WA_API_KEY=

# Time Tracker (stopwatch) — rounding & minimum billable per session
SESSION_MIN_BILLABLE_MINUTES=15
SESSION_ROUNDING_MINUTES=15
SESSION_STALE_HOURS=24

# Proxy tepercaya (mis. ngrok / load balancer). Pisahkan dengan koma, atau "*".
# TRUSTED_PROXIES=127.0.0.1

# Wizard instalasi pertama (/setup). Opsional: wajibkan token.
SETUP_TOKEN=
# Cek versi terbaru dari GitHub Releases (owner/nama). false = matikan.
ETAGIH_UPDATE_REPO=destroylord/etagih
ETAGIH_UPDATE_CHECK=true
# Default dari file VERSION; "dev" = lewati cek update.
# APP_VERSION=
