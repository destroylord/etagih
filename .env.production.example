# =============================================================================
# eTagih — .env PRODUKSI (salin ke .env di VPS lalu isi semua yang ditandai ⚠)
# =============================================================================

APP_NAME=eTagih
APP_ENV=production
APP_DEBUG=false
# ⚠ Buat dengan: docker compose run --rm app php artisan key:generate --show
APP_KEY=
# ⚠ Domain tanpa https:// (dipakai Caddy untuk sertifikat SSL otomatis)
APP_DOMAIN=invoice.domainkamu.com
# ⚠ Harus sama dengan APP_DOMAIN (ditulis lengkap, tanpa ${...})
APP_URL=https://invoice.domainkamu.com
# Email untuk notifikasi Let's Encrypt (opsional tapi disarankan)
ACME_EMAIL=

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# Log harian di volume storage, simpan 14 hari.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Database (container `db`) ---
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=etagih
DB_USERNAME=etagih
# ⚠ Ganti dengan password acak yang panjang (mis. hasil: openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Jalankan migrasi otomatis tiap container app start (aman: --force, idempoten).
RUN_MIGRATIONS=true

# --- Email (invoice + PDF dikirim ke email klien) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@domainkamu.com
MAIL_FROM_NAME=eTagih

# --- QRISLY (Komerce) ---
# false = sandbox. Ubah ke true saat siap menerima pembayaran sungguhan.
QRISLY_IS_PRODUCTION=false
QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
QRISLY_PRODUCTION_BASE_URL=https://api.collaborator.komerce.id/user
QRISLY_API_KEY=
# Cadangan bila belum upload QRIS di Pengaturan → QRIS
QRISLY_MERCHANT_ID=

# --- WhatsApp (Fonnte) ---
FONNTE_BASE_URL=https://api.fonnte.com
WA_API_KEY=

# --- Time Tracker ---
SESSION_ROUNDING_MINUTES=15
SESSION_MIN_BILLABLE_MINUTES=15
SESSION_STALE_HOURS=24


# --- Image Docker siap pakai (dibaca docker compose dari .env) ---
# Prefix image di registry, mis. ghcr.io/namaowner. Tag: versi (1.2.0), latest, atau edge.
ETAGIH_IMAGE=ghcr.io/destroylord
ETAGIH_VERSION=latest

# --- Instalasi pertama & update ---
# Opsional: bila diisi, wizard /setup meminta token ini (buka https://domain/setup?token=...).
SETUP_TOKEN=
# Repo GitHub untuk cek versi terbaru (owner/nama). false = matikan cek update.
ETAGIH_UPDATE_REPO=destroylord/etagih
ETAGIH_UPDATE_CHECK=true
# Versi aplikasi sudah tertanam di image; isi hanya bila perlu menimpanya.
# APP_VERSION=
